<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ZakazActivity">

    <!-- Шапка таблицы -->
    <LinearLayout
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="№"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_weight="0.15"
            android:layout_gravity="center"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Заказ"
            android:textColor="@color/black"
            android:layout_weight="0.60"
            android:layout_gravity="center"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Дата"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_weight="0.25"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Разделитель под шапкой -->
    <View
        android:id="@+id/horizont"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/ll"
        android:background="@android:color/black" />

    <!-- Сам список. Привязываем его верх к разделителю, а НИЗ к низу экрана (parent) -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/horizont"
        app:layout_constraintBottom_toBottomOf="parent"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        />

    <!-- Прогресс-бар по центру экрана, скрыт по умолчанию -->
    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>