<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".AdminActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заказы"
        android:background="@drawable/zakaz"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="zakaz"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Материалы"
        android:background="@drawable/mater"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="mater"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Зарплата"
        android:background="@drawable/zp"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="zp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Прочие расходы"
        android:background="@drawable/rashod"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="rashod"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Финансовая отчётность"
        android:background="@drawable/fin"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="fin"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сотрудники"
        android:background="@drawable/wokers"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="wokers"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Рабочий процесс"
        android:background="@drawable/otchet"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="otchet"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Управление доступом"
        android:background="@drawable/dostup"
        android:layout_margin="14dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:onClick="dos"/>

</LinearLayout>